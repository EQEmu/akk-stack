#!/usr/bin/python3 -I
"""Fixed isolated Rust and affected-object checks on an exact dirty source snapshot."""
import argparse
import json
from pathlib import Path
import sys
import tempfile
import time

sys.dont_write_bytecode=True
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'validation/worker'))
from client import CONFIG,exchange
from quick_prepare import prepare,tool_identity
import quick_snapshot as snapshot
from quick_guest import unavailable
from snapshot_apply import publish


def failure(error,value=None,tool=None,submitted=False):
    result=dict(version=1,scope='working-snapshot-quickcheck',operation='quick',advisory=True,
                vm_started=None if submitted else False,cleanup_complete=False,**unavailable(error,value))
    if value is not None:
        identity=snapshot.identity(value)
        result.update({key:identity[key] for key in ('base','head','input_snapshot_sha256','recipe_sha256')})
        result['output_snapshot_sha256']=identity['input_snapshot_sha256']
        result.update({key:tool[key] for key in ('implementation_sha256','rust_input_sha256','native_input_sha256')})
    return result


def main(argv=None):
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo',type=Path,default=Path.cwd());parser.add_argument('--base')
    mode=parser.add_mutually_exclusive_group();mode.add_argument('--identity',action='store_true');mode.add_argument('--snapshot-identity',action='store_true')
    parser.add_argument('--expected-input');parser.add_argument('--output',type=Path);parser.add_argument('--config',type=Path,default=CONFIG)
    parser.add_argument('--websocketpp',type=Path);parser.add_argument('--input-store',type=Path,default=Path.home()/'.local/state/eqemu-vm-proof')
    parser.add_argument('--rust-package',choices=tuple(snapshot.RUST_PACKAGES),default='original')
    parser.add_argument('--rust-input',type=Path,default=Path.home()/'.local/state/eqemu-rust-validator/inputs/bundle-1.99.0-cxx194/rust-inputs.tar')
    args=parser.parse_args(argv)
    if not args.identity and not args.base:parser.error('--base is required')
    if not args.identity and not args.snapshot_identity and (not args.expected_input or not args.output):parser.error('Execution requires --expected-input and fresh --output')
    if args.output and (not args.output.is_absolute() or args.output.parent.resolve()!=args.output.parent.absolute()
            or args.output.resolve().is_relative_to(args.repo.resolve()) or args.output.exists() or args.output.is_symlink()):
        print(json.dumps(dict(version=1,scope='working-snapshot-quickcheck',advisory=True,exit_code=2,error='Output artifact path rejected')));return 2
    value=tool=None;submitted=False;started=time.monotonic()
    try:
        tool=tool_identity(ROOT,args.rust_package)
        if args.identity:print(json.dumps(tool,separators=(',',':')));return 0
        value=snapshot.capture(args.repo,args.base,tool['recipe_sha256'])
        if args.snapshot_identity:print(json.dumps(snapshot.identity(value),separators=(',',':')));return 0
        if snapshot.identity(value)['input_snapshot_sha256']!=args.expected_input:raise ValueError('Stale expected quick input')
        config=json.loads(args.config.read_text())
        if exchange(config['socket'],dict(version=1,operation='check'))['exit_code']!=0:raise RuntimeError('Worker readiness failed')
        with tempfile.TemporaryDirectory(prefix='eqemu-quick-client-') as tmp:
            output=Path(tmp)/'payload.iso'
            request=prepare(args.repo,value,args.websocketpp or args.repo/'submodules/websocketpp',
                args.input_store/'build-inputs-20260925-v3/build-inputs.iso',args.rust_input,output,args.rust_package)
            if snapshot.capture(args.repo,args.base,tool['recipe_sha256'])!=value:raise ValueError('Quick input changed before submission')
            submitted=True;response=exchange(config['socket'],request,output)
        snapshot.validate_result(response,value,tool)
        if snapshot.capture(args.repo,args.base,tool['recipe_sha256'])!=value:raise ValueError('Quick input changed during execution')
        result=response;result['timings']['client_total_seconds']=round(time.monotonic()-started,3)
    except KeyboardInterrupt:
        result=failure('Client interrupted; socket closed for owned worker cancellation',value,tool,submitted)
    except Exception as error:
        result=failure(error,value,tool,submitted)
    if args.output:
        try:publish(args.output,result,limit=snapshot.RESULT_LIMIT)
        except Exception:
            print(json.dumps(dict(version=1,scope='working-snapshot-quickcheck',advisory=True,exit_code=2,error='Result publication failed')));return 2
    public={key:result[key] for key in ('version','scope','operation','advisory','exit_code','base','head','input_snapshot_sha256',
        'output_snapshot_sha256','recipe_sha256','implementation_sha256','vm_started','cleanup_complete','selected_checks',
        'completed_checks','failed_checks','unavailable_checks','skipped_checks','timings') if key in result}
    public['output']=str(args.output) if args.output else None
    print(json.dumps(public,separators=(',',':')))
    return result['exit_code']


if __name__=='__main__':raise SystemExit(main())
