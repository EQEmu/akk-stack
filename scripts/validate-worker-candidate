#!/usr/bin/python3 -I
"""Build/test one clean committed candidate inside the dedicated offline VM worker."""
import argparse
import json
import os
from pathlib import Path
import sys
import tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'validation/worker'))
from client import CONFIG, exchange
from prepare import prepare
from identity import identity
from normal_world import EvidenceBudgetError, export_evidence


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', type=Path, default=Path.cwd())
    parser.add_argument('--commit', default='HEAD')
    parser.add_argument('--websocketpp', type=Path)
    parser.add_argument('--input-store', type=Path, default=Path.home() / '.local/state/eqemu-vm-proof')
    parser.add_argument('--rust-input', type=Path, default=Path.home() / '.local/state/eqemu-rust-validator/inputs/bundle-1.99.0-cxx194/rust-inputs.tar')
    parser.add_argument('--runtime-input', type=Path, help='Pinned public runtime ISO (default: declared path under input-store)')
    parser.add_argument('--world-control', choices=('startup', 'assertion', 'cancel'), help='Fixed non-passing normal-world qualification control')
    parser.add_argument('--config', type=Path, default=CONFIG)
    parser.add_argument('--profile', choices=('asan-ubsan-native-v1',), help='Requires separately admitted diagnostic worker')
    parser.add_argument('--prepare-only', type=Path, metavar='OUTPUT_ISO')
    parser.add_argument('--identity', action='store_true', help='Print AFK contract identity without connecting to the worker or running candidate code')
    args = parser.parse_args()
    try:
        fixture = json.loads((Path(__file__).resolve().parents[1] / 'validation/runtime-fixture.json').read_text())
        runtime_input = args.runtime_input or args.input_store / fixture['iso']['path']
        if args.profile and json.loads(args.config.read_text()).get('diagnostic_profile') != args.profile:
            raise RuntimeError('Selected frontend and admitted worker profiles differ')
        if args.identity:
            print(json.dumps(identity(Path(__file__).resolve().parents[1], args.config,
                                     args.input_store / 'build-inputs-20260925-v3/build-inputs.iso',
                                     args.rust_input, runtime_input), separators=(',', ':')))
            return 0
        with tempfile.TemporaryDirectory(prefix='eqemu-candidate-') as tmp:
            output = args.prepare_only or Path(tmp) / 'payload.iso'
            if not args.prepare_only:
                config = json.loads(args.config.read_text())
                if config.get('diagnostic_profile') != args.profile:
                    raise RuntimeError('Selected frontend and admitted worker profiles differ')
                readiness = exchange(config['socket'], {'version': 1, 'operation': 'check'})
                if readiness['exit_code'] != 0:
                    raise RuntimeError('Worker readiness failed: ' + json.dumps(readiness))
                if int(readiness['observed']['resources']['memory.max']) < 6 * 1024**3:
                    raise RuntimeError('Apply the reviewed 6 GiB/18360-second worker service update first')
            request = prepare(args.repo, args.commit, args.websocketpp or args.repo / 'submodules/websocketpp',
                              args.input_store / 'build-inputs-20260925-v3/build-inputs.iso', args.rust_input, output, runtime_input,
                              args.world_control, **({'diagnostic_profile': args.profile} if args.profile else {}))
            if args.prepare_only:
                # Preparation success is explicitly not an execution pass.
                print(json.dumps(dict(scope='prepared-input-only', executed=False, request=request)))
                return 0
            report = exchange(config['socket'], request, output)
            directory = os.environ.get('VALIDATION_AFK_EVIDENCE_DIR')
            if report.get('exit_code') in (0, 1, 2) and report.get('guest', {}).get('normal_world'):
                directory = directory or Path.home()/'.local/state/eqemu-rust-validator/runs'/report['run_id']
                try:
                    artifact = export_evidence(report, request['candidate'], directory)
                    if artifact:
                        report['diagnostic_artifact'] = str(artifact)
                except EvidenceBudgetError:
                    report['diagnostic_export_error'] = 'irreducible-artifact-budget'
                except Exception:
                    report['diagnostic_export_error'] = 'artifact-export-failed'
    except KeyboardInterrupt:
        report = {'version': 1, 'exit_code': 2, 'error': 'Client interrupted; owned worker cancellation requested by socket close'}
    except Exception as error:
        report = {'version': 1, 'exit_code': 2, 'error': str(error)[-4000:]}
    print(json.dumps(report, separators=(',', ':')))
    # Export is a separate host outcome; never relabel the worker/native cause.
    return 2 if report.get('diagnostic_export_error') else report['exit_code']


if __name__ == '__main__':
    raise SystemExit(main())
